# LOCAL: copie para .env.local e preencha as chaves
#   copy .env.example .env.local
#   npm run dev
#
# =============================================================================
# VARIÁVEIS OBRIGATÓRIAS (Vercel → Settings → Environment Variables)
# =============================================================================
#
# Onde pegar no Supabase:
#   Dashboard → Project Settings → API
#
# ┌─────────────────────────────────────┬──────────────────────────────────────┐
# │ Variável no Vercel                  │ Valor no Supabase                    │
# ├─────────────────────────────────────┼──────────────────────────────────────┤
# │ NEXT_PUBLIC_SUPABASE_URL            │ Project URL                          │
# │ NEXT_PUBLIC_SUPABASE_ANON_KEY       │ anon public  (chave PÚBLICA)         │
# │ SUPABASE_SERVICE_ROLE_KEY           │ service_role (chave SECRETA)         │
# └─────────────────────────────────────┴──────────────────────────────────────┘
#
# ⚠️  NÃO coloque service_role em variável NEXT_PUBLIC_* (vaza no navegador).
# ⚠️  NEXT_PUBLIC_APP_URL é a URL do SEU SITE (Vercel), não do Supabase.
# ⚠️  Na Vercel: após salvar variáveis, clique em REDEPLOY (build precisa delas).
#
# Supabase → Authentication → URL Configuration (ajuste após deploy):
#   Site URL:     https://seu-projeto.vercel.app
#   Redirect URLs: https://seu-projeto.vercel.app/auth/callback
#
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://urniufkvxgoarerlrpny.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVybml1Zmt2eGdvYXJlcmxycG55Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk2MTExNjIsImV4cCI6MjA4NTE4NzE2Mn0.YMd5hF4oPKMGmIsR13jo_d_QsWtZqlTUU68sI4WVItg

# Apenas servidor (webhooks InfinityPay, confirmação de pagamento)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVybml1Zmt2eGdvYXJlcmxycG55Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2OTYxMTE2MiwiZXhwIjoyMDg1MTg3MTYyfQ.2gjlVLVx_mm6ulunPAbCsNVXXaOH6mffDHGGzXg4O3A

# URL do site em produção — use seu domínio Registro.br após configurar DNS
# Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_APP_URL=https://www.seudominio.com.br

# InfinityPay — sua InfiniteTag (já usada no código como padrão)
INFINITYPAY_HANDLE=drxbackup

# Opcional: upload de PDF/imagens no painel admin (Vercel → Storage → Blob)
# BLOB_READ_WRITE_TOKEN=
